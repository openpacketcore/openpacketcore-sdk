+		    p->dir != XFRM_POLICY_OUT || p->action != XFRM_POLICY_ALLOW ||
+		    p->sel.proto != IPPROTO_NONE || p->sel.sport || p->sel.dport ||
+		    p->sel.sport_mask || p->sel.dport_mask || nr != 1 ||
+		    len != sizeof(*p) + sizeof(*ut) ||
+		    ut->id.proto != IPPROTO_ESP || !ut->id.spi || ut->optional ||
+		    (ut->mode != XFRM_MODE_TRANSPORT && ut->mode != XFRM_MODE_TUNNEL))
+			return NULL;
+	}
+
 	xp = xfrm_policy_alloc(net, GFP_ATOMIC);
 	if (xp == NULL) {
 		*dir = -ENOBUFS;
--- a/net/xfrm/xfrm_output.c
+++ b/net/xfrm/xfrm_output.c
@@ -489,6 +489,39 @@
 EXPORT_SYMBOL_GPL(pktgen_xfrm_outer_mode_output);
 #endif
 
+static bool xfrm_tfc_dummy(const struct dst_entry *dst)
+{
+	const struct xfrm_dst *xdst = (const struct xfrm_dst *)dst;
+	int i;
+
+	for (i = 0; i < xdst->num_pols; i++)
+		if (xdst->pols[i]->flags & XFRM_POLICY_TFC_DUMMY)
+			return true;
+	return false;
+}
+
+/* Keep dummy traffic on the normal software ESP sequence/crypto path. */
+static bool xfrm_tfc_dummy_valid(struct sk_buff *skb, struct xfrm_state *x)
+{
+	const struct xfrm_dst *xdst = (const struct xfrm_dst *)skb_dst(skb);
+
+	if (xdst->num_pols != 1 || xdst->num_xfrms != 1 ||
+	    xfrm_dst_child(skb_dst(skb))->xfrm || x->id.proto != IPPROTO_ESP ||
+	    (x->props.mode != XFRM_MODE_TRANSPORT && x->props.mode != XFRM_MODE_TUNNEL) ||
+	    x->xso.type != XFRM_DEV_OFFLOAD_UNSPECIFIED || skb_is_gso(skb))
+		return false;
+
+	switch (skb->protocol) {
+	case htons(ETH_P_IP):
+		return ip_hdr(skb)->ihl == 5 && !ip_is_fragment(ip_hdr(skb)) &&
+		       ip_hdr(skb)->protocol == IPPROTO_NONE;
+	case htons(ETH_P_IPV6):
+		return ipv6_hdr(skb)->nexthdr == IPPROTO_NONE;
+	default:
+		return false;
+	}
+}
+
 static int xfrm_output_one(struct sk_buff *skb, int err)
 {
 	struct dst_entry *dst = skb_dst(skb);
@@ -512,6 +545,9 @@
 			XFRM_INC_STATS(net, LINUX_MIB_XFRMOUTSTATEMODEERROR);
 			goto error_nolock;
 		}
+
+		if (xfrm_tfc_dummy(skb_dst(skb)))
+			*skb_mac_header(skb) = IPPROTO_NONE;
 
 		spin_lock_bh(&x->lock);
 
@@ -747,6 +783,12 @@
 	int family;
 	int err;
 
+	if (xfrm_tfc_dummy(skb_dst(skb)) && !xfrm_tfc_dummy_valid(skb, x)) {
+		XFRM_INC_STATS(net, LINUX_MIB_XFRMOUTERROR);
+		kfree_skb(skb);
+		return -EOPNOTSUPP;
+	}
+
 	family = (x->xso.type != XFRM_DEV_OFFLOAD_PACKET) ? x->outer_mode.family
 		: skb_dst(skb)->ops->family;
 
