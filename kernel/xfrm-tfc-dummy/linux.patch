Subject: [PATCH] xfrm: submit RFC 4303 dummies through a socket policy

Generate tunnel-mode ESP Next Header 59 on an existing SA while
retaining normal kernel sequence allocation, encryption and lifetime
enforcement. Only a required single ESP template may opt in through a
per-socket policy; reject stacked transforms and hardware offload before
output. Dummy requests cannot acquire a missing SA. Normal policies
retain their existing behavior.

Advertise the provisional OPCTFC01 ABI through GETSADINFO so callers can
reject unpatched kernels before using the otherwise ignored policy flag.
This local patch has not been submitted upstream.

---
--- a/include/uapi/linux/xfrm.h
+++ b/include/uapi/linux/xfrm.h
@@ -345,6 +345,7 @@
 	XFRMA_SAD_UNSPEC,
 	XFRMA_SAD_CNT,
 	XFRMA_SAD_HINFO,
+	XFRMA_SAD_TFC_DUMMY, /* OPCTFC01 followed by native u32 AF mask */
 	__XFRMA_SAD_MAX
 
 #define XFRMA_SAD_MAX (__XFRMA_SAD_MAX - 1)
@@ -446,6 +447,7 @@
 	/* Automatically expand selector to include matching ICMP payloads. */
 #define XFRM_POLICY_ICMP	2
 #define XFRM_POLICY_CPU_ACQUIRE	4
+#define XFRM_POLICY_TFC_DUMMY	8 /* per-socket RFC 4303 dummy output */
 	__u8				share;
 };
 
--- a/net/xfrm/xfrm_user.c
+++ b/net/xfrm/xfrm_user.c
@@ -1743,12 +1743,18 @@
 {
 	return NLMSG_ALIGN(4)
 	       + nla_total_size(sizeof(struct xfrmu_sadhinfo))
-	       + nla_total_size(4); /* XFRMA_SAD_CNT */
+	       + nla_total_size(4) /* XFRMA_SAD_CNT */
+	       + nla_total_size(12); /* XFRMA_SAD_TFC_DUMMY */
 }
 
 static int build_sadinfo(struct sk_buff *skb, struct net *net,
 			 u32 portid, u32 seq, u32 flags)
 {
+	const struct {
+		char magic[8];
+		u32 families;
+	} tfc_dummy = { "OPCTFC01", (IS_ENABLED(CONFIG_INET_ESP) ? 1 : 0) |
+		(IS_ENABLED(CONFIG_INET6_ESP) ? 2 : 0) };
 	struct xfrmk_sadinfo si;
 	struct xfrmu_sadhinfo sh;
 	struct nlmsghdr *nlh;
@@ -1769,6 +1775,9 @@
 	err = nla_put_u32(skb, XFRMA_SAD_CNT, si.sadcnt);
 	if (!err)
 		err = nla_put(skb, XFRMA_SAD_HINFO, sizeof(sh), &sh);
+	if (!err)
+		err = nla_put(skb, XFRMA_SAD_TFC_DUMMY, sizeof(tfc_dummy),
+			      &tfc_dummy);
 	if (err) {
 		nlmsg_cancel(skb, nlh);
 		return err;
@@ -2248,6 +2257,10 @@
 	err = verify_newpolicy_info(p, extack);
 	if (err)
 		return err;
+	if (p->flags & XFRM_POLICY_TFC_DUMMY) {
+		NL_SET_ERR_MSG(extack, "TFC dummy requires a per-socket policy");
+		return -EOPNOTSUPP;
+	}
 	err = verify_sec_ctx_len(attrs, extack);
 	if (err)
 		return err;
@@ -3911,6 +3924,17 @@
 	if (p->dir > XFRM_POLICY_OUT)
 		return NULL;
 
+	if (p->flags & XFRM_POLICY_TFC_DUMMY) {
