{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpacketcore.dev/schemas/session-mtls-batch-release-gate-evidence/v1",
  "title": "Closed local persistent-V2 batch release-gate evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experimental", "qualification_complete", "cargo_profile", "opt_level", "debug_assertions", "bindings", "members", "clients", "lanes_per_client", "logical_operations_per_second", "warm_status_samples", "warm_status_request_cardinality", "warm_status_request_index_min", "warm_status_request_index_max", "warm_status_request_stride", "active_history_entries", "normal_configured_lanes", "normal_active_lanes", "normal_idle_lanes", "original_fixed_pools", "supplemental_pools", "aggregate_setup_attempts", "aggregate_setup_failures", "aggregate_setup_successes", "typed_read_unavailable_retries", "typed_read_unavailable_retry_high_water", "aggregate_pool_wait_max", "resource_generations", "positive_new_credential_new_server_statuses"],
  "properties": {
    "schema_version": {"const": "opc-session-mtls-batch-release-gate-evidence/v1"}, "experimental": {"const": true}, "qualification_complete": {"const": false}, "cargo_profile": {"const": "release"}, "opt_level": {"const": "3"}, "debug_assertions": {"const": false},
    "bindings": {"$ref": "#/$defs/bindings"}, "members": {"const": 3}, "clients": {"const": 12}, "lanes_per_client": {"const": 4}, "logical_operations_per_second": {"const": 1000},
    "warm_status_samples": {"const": 1008}, "warm_status_request_cardinality": {"const": 1008}, "warm_status_request_index_min": {"const": 1}, "warm_status_request_index_max": {"const": 49980}, "warm_status_request_stride": {"const": 53}, "active_history_entries": {"const": 110001},
    "normal_configured_lanes": {"const": 48}, "normal_active_lanes": {"const": 48}, "normal_idle_lanes": {"const": 48},
    "original_fixed_pools": {"$ref": "#/$defs/original_fixed_pools"},
    "supplemental_pools": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"$ref": "#/$defs/old_credential_new_only_server"}, {"$ref": "#/$defs/delayed_response_ambiguity"}, {"$ref": "#/$defs/new_credential_old_root_server"}], "items": false},
    "aggregate_setup_attempts": {"type": "integer", "minimum": 0}, "aggregate_setup_failures": {"type": "integer", "minimum": 0}, "aggregate_setup_successes": {"type": "integer", "minimum": 0}, "typed_read_unavailable_retries": {"type": "integer", "minimum": 0}, "typed_read_unavailable_retry_high_water": {"type": "integer", "minimum": 0}, "aggregate_pool_wait_max": {"type": "integer", "minimum": 0, "maximum": 64},
    "resource_generations": {"$ref": "#/$defs/resource_generations"}, "positive_new_credential_new_server_statuses": {"const": 4}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["evidence_schema_sha256", "configuration_sha256", "public_material_manifest_sha256", "workload_schedule_sha256", "source_revision", "source_worktree_sha256", "child_sha256", "harness_sha256"], "properties": {"evidence_schema_sha256": {"$ref": "#/$defs/sha256"}, "configuration_sha256": {"$ref": "#/$defs/sha256"}, "public_material_manifest_sha256": {"$ref": "#/$defs/sha256"}, "workload_schedule_sha256": {"$ref": "#/$defs/sha256"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "source_worktree_sha256": {"$ref": "#/$defs/sha256"}, "child_sha256": {"$ref": "#/$defs/sha256"}, "harness_sha256": {"$ref": "#/$defs/sha256"}}},
    "pool": {"type": "object", "additionalProperties": false, "required": ["role", "setup_attempts", "setup_failures", "setup_successes", "pool_wait_current", "pool_wait_max", "configured_lanes", "active_lanes", "idle_lanes"], "properties": {"role": {"type": "string"}, "setup_attempts": {"type": "integer", "minimum": 1}, "setup_failures": {"type": "integer", "minimum": 0}, "setup_successes": {"type": "integer", "minimum": 0}, "pool_wait_current": {"const": 0}, "pool_wait_max": {"type": "integer", "minimum": 0, "maximum": 64}, "configured_lanes": {"type": "integer", "minimum": 1}, "active_lanes": {"type": "integer", "minimum": 0}, "idle_lanes": {"type": "integer", "minimum": 0}}},
    "original_fixed_pools": {"allOf": [{"$ref": "#/$defs/pool"}, {"properties": {"role": {"const": "original_fixed_pools"}, "configured_lanes": {"const": 48}, "active_lanes": {"const": 48}, "idle_lanes": {"const": 48}}}]},
    "old_credential_new_only_server": {"allOf": [{"$ref": "#/$defs/pool"}, {"properties": {"role": {"const": "old_credential_new_only_server"}, "configured_lanes": {"const": 4}, "active_lanes": {"const": 0}, "idle_lanes": {"const": 0}, "setup_successes": {"const": 0}, "setup_failures": {"type": "integer", "minimum": 1}}}]},
    "delayed_response_ambiguity": {"allOf": [{"$ref": "#/$defs/pool"}, {"properties": {"role": {"const": "delayed_response_ambiguity"}, "configured_lanes": {"const": 4}, "active_lanes": {"const": 0}, "idle_lanes": {"const": 0}, "setup_successes": {"type": "integer", "minimum": 1}}}]},
    "new_credential_old_root_server": {"allOf": [{"$ref": "#/$defs/pool"}, {"properties": {"role": {"const": "new_credential_old_root_server"}, "configured_lanes": {"const": 4}, "active_lanes": {"const": 0}, "idle_lanes": {"const": 0}, "setup_successes": {"const": 0}, "setup_failures": {"type": "integer", "minimum": 1}}}]},
    "resource_generation": {"type": "object", "additionalProperties": false, "required": ["logical_voter_index", "process_id", "samples"], "properties": {"logical_voter_index": {"type": "integer", "minimum": 0, "maximum": 2}, "process_id": {"type": "integer", "minimum": 1}, "samples": {"type": "integer", "minimum": 1}}},
    "voter_0": {"allOf": [{"$ref": "#/$defs/resource_generation"}, {"properties": {"logical_voter_index": {"const": 0}}}]}, "voter_1": {"allOf": [{"$ref": "#/$defs/resource_generation"}, {"properties": {"logical_voter_index": {"const": 1}}}]}, "voter_2": {"allOf": [{"$ref": "#/$defs/resource_generation"}, {"properties": {"logical_voter_index": {"const": 2}}}]},
    "resource_generations": {"type": "array", "minItems": 4, "maxItems": 4, "anyOf": [{"prefixItems": [{"$ref": "#/$defs/voter_0"}, {"$ref": "#/$defs/voter_0"}, {"$ref": "#/$defs/voter_1"}, {"$ref": "#/$defs/voter_2"}], "items": false}, {"prefixItems": [{"$ref": "#/$defs/voter_0"}, {"$ref": "#/$defs/voter_1"}, {"$ref": "#/$defs/voter_1"}, {"$ref": "#/$defs/voter_2"}], "items": false}, {"prefixItems": [{"$ref": "#/$defs/voter_0"}, {"$ref": "#/$defs/voter_1"}, {"$ref": "#/$defs/voter_2"}, {"$ref": "#/$defs/voter_2"}], "items": false}]}
  }
}
