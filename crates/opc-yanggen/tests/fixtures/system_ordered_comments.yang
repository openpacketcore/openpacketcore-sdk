
module opc-test {
  yang-version 1.1;
  namespace "urn:opc:test";
  prefix test;

  import opc-annotations {
    prefix opc;
    revision-date 2026-01-01;
  }

  revision 2026-06-28 {
    description "Only this documentation changed.";
  }

  container system {
    description "A different description should not affect schema digest.";

    leaf enabled {
      type boolean;
      default "true";
      description "Documentation-only change.";
    }

    leaf secret {
      type string;
      opc:data-class "security-secret";
    }

    list peer {
      key "name";
      unique "port";

      leaf name {
        type string;
      }

      leaf port {
        type uint16;
      }
    }

    container state {
      config false;

      leaf uptime {
        type uint32;
      }
    }
  }
}
